@model JobItemViewModel
@section Scripts
{
}
@{
    ViewBag.Title = "Developer Operation";
    Layout = "~/Views/Shared/FormPage.cshtml";
}

@using (Html.BeginForm())
{
    <div style="border-bottom: 1px dotted #998675;margin-top: 30px;margin-bottom: 10px;height: 35px;">
        <div style="float:left; font-size:x-large;color:brown;">Search Criteria</div>
        <div id="divOperationBtn" style="float:right">
            <img id="imgLoadingJobItem" src="~/Content/images/loading.gif" style="display:none;" />
            <input type="button" id="btnUpdateDSZ" class="k-button" value="Update DSZ Data and Sync" />
            <input type="button" id="btnImportData" class="k-button" value="Import Data" />
            <input type="button" id="btnImportCostwayData" class="k-button" value="Import Costway Data" />
        </div>
    </div>

    <script>
        $(document).ready(function () {

            $('#btnImportData').click(function () {
                        var link="@Html.Raw(Url.Action("ImportData", "Misc"))"

                        $.ajax({
                            url: link,
                            type: "POST",
                            dataType: "json",
                            beforeSend: function () {
                                $("#imgLoading").show();
                            },
                            complete: function () {
                                $("#imgLoading").hide();
                            },
                            success: function (data) {
                                if (data.Result) {
                                    alert("Import Data Success");
                                }
                                else {
                                    //debugger;
                                    if (data.Message != "")
                                        alert(data.Message);
                                    else
                                        alert("Unknown error occurred.");
                                }
                            },
                            error: function (data) {
                                //debugger;

                                alert("error");
                            }
                        });
                        return false;
            });

            $('#btnImportCostwayData').click(function () {
                        var link="@Html.Raw(Url.Action("ImportCostwayData", "Misc"))"

                        $.ajax({
                            url: link,
                            type: "POST",
                            dataType: "json",
                            beforeSend: function () {
                                $("#imgLoading").show();
                            },
                            complete: function () {
                                $("#imgLoading").hide();
                            },
                            success: function (data) {
                                if (data.Result) {
                                    alert("Import Data Success");
                                }
                                else {
                                    //debugger;
                                    if (data.Message != "")
                                        alert(data.Message);
                                    else
                                        alert("Unknown error occurred.");
                                }
                            },
                            error: function (data) {
                                //debugger;

                                alert("error");
                            }
                        });
                        return false;
                    });

                    $('#btnUpdateDSZ').click(function () {
                        var link="@Html.Raw(Url.Action("UpdateDSZandSync", "JobItem"))"

                        $.ajax({
                            url: link,
                            type: "POST",
                            dataType: "json",
                            beforeSend: function () {
                                $("#imgLoading").show();
                            },
                            complete: function () {
                                $("#imgLoading").hide();
                            },
                            success: function (data) {
                                if (data.Result) {
                                    alert("Update DSZ Success");
                                }
                                else {
                                    //debugger;
                                    if (data.Message != "")
                                        alert(data.Message);
                                    else
                                        alert("Unknown error occurred.");
                                }
                            },
                            error: function (data) {
                                //debugger;

                                alert("error");
                            }
                        });
                        return false;
                    });

        });
    </script>
       }
