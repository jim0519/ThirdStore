@model ItemViewModel
@section Scripts
{
}
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/FormPage.cshtml";
}

@using (Html.BeginForm())
{
    <div id="divUploadImage" style="float: left; margin: 8px 0;">
        <input type="file" id="uploadImages" name="uploadImages" multiple accept="image/*" />
        <input type="button" id="btnUpload" value="Upload" />
        <img name="imgUploadLoading" src="~/Content/images/loading.gif" style="display:none; vertical-align:middle;" />
    </div>
    @Html.Partial("_CreateOrEdit", Model)
}

